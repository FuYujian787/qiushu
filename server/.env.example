# 求书 · 書緣 — 环境变量配置
# 复制此文件为 .env 并填入真实值

# JWT 签名密钥（必填，用 python -c "import secrets; print(secrets.token_urlsafe(32))" 生成）
JWT_SECRET_KEY=change-me-to-a-random-secret

# Flask 应用密钥
SECRET_KEY=change-me-to-another-random-secret

# DeepSeek API 密钥（必填，从 platform.deepseek.com 获取）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# Flask 调试模式（生产环境必须设为 false）
FLASK_DEBUG=false
